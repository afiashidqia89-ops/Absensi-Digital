# ─────────────────────────────────────────────────────────────
# Contoh environment variable — salin jadi .env lalu isi
# ─────────────────────────────────────────────────────────────

# DATABASE (WAJIB)
# Produksi: buat project di https://neon.tech → salin "Pooled connection"
# (bertanda -pooler) dan tambahkan parameter pgbouncer bila perlu.
# Contoh:
DATABASE_URL="postgresql://user:password@ep-cool-name-a1b2c3d4-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Pengembangan lokal (sandbox/preview) memakai SQLite:
# DATABASE_URL="file:/home/z/my-project/db/custom.db"
